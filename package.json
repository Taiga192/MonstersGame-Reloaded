{
  "name": "monstersgame",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Taiga192",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test --test-timeout=300000 --test-force-exit \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/assets.ts",
    "art": "node scripts/import-art.ts",
    "test:wasm": "node --import ./test/wasm-preload.ts --test --test-timeout=300000 --test-force-exit \"test/*.test.ts\"",
    "build:pages": "node scripts/build-pages.ts",
    "preview": "node scripts/preview.ts dist /MonstersGame/ 8080",
    "e2e": "node scripts/e2e-browser.ts",
    "build:online": "node scripts/build-pages.ts",
    "e2e:online": "node scripts/e2e-online.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.0"
  }
}