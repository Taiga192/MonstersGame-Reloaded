# Copy to .env (never commit it). Everything is optional; the defaults are safe.

# Number of bots (0 = none)
BOTS=100

# Private server: only people who know this code can create an account. Leave empty for a public server.
# REGISTRATION_CODE=pick-a-long-random-phrase

# Only if the game FRONTEND is hosted on another site (itch.io, GitHub Pages): which sites may call the API.
# Exact origins or https://*.domain, comma separated. Leave empty when the game server serves the frontend itself.
# CORS_ORIGINS=https://*.itch.zone,https://YOURNAME.github.io

# Bots may attack real players: share of finds that turn into an attack (0.3 = 30 %); BOTS_RAID_HUMANS=0 turns it off.
# BOTS_HUMAN_RAID_CHANCE=0.3

# Rate limits (defaults shown): registrations per hour per address, logins per 10 minutes per address, API calls per minute per address
# RATE_REGISTER_PER_HOUR=5
# RATE_LOGIN_PER_10MIN=20
# RATE_API_PER_MIN=600

# Backups: every N hours (0 = off), keep the newest N files
# BACKUP_EVERY_HOURS=6
# BACKUP_KEEP=28
